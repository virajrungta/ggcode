# Copy to .env. Never commit .env (already covered by .gitignore).
GG_ENV=development
GG_AUTH_MODE=dev          # 'dev' trusts X-Dev-User; use 'firebase' for real tokens
GG_DATABASE_URL=sqlite+aiosqlite:///./greengenius.db
GG_MQTT_HOST=localhost
GG_MQTT_PORT=1883
GG_MQTT_TLS=false
GG_SIMULATE=0
GG_FIREBASE_PROJECT_ID=greengenius-b9d6f
GG_PLANT_ID_API_KEY=
GG_TREFLE_API_TOKEN=
GG_CORS_ORIGINS=["http://localhost:3000"]
